@startuml
title Research-Oriented University System - Full Use Case Diagram
left to right direction
skinparam packageStyle rectangle

actor Guest
actor User
actor Admin
actor Manager
actor Teacher
actor Student
actor Employee
actor Researcher

User <|-- Admin
User <|-- Manager
User <|-- Teacher
User <|-- Student
User <|-- Employee
User <|-- Researcher

rectangle "Research-Oriented University System" {
  usecase "Login" as UC_Login
  usecase "Logout" as UC_Logout
  usecase "Change Password" as UC_ChangePassword
  usecase "Deactivate Own Account" as UC_DeleteAccount

  usecase "Manage Users" as UC_ManageUsers
  usecase "Add User" as UC_AddUser
  usecase "Update User" as UC_UpdateUser
  usecase "Deactivate User" as UC_RemoveUser
  usecase "View Action Logs" as UC_ViewLogs
  usecase "Manage Courses" as UC_ManageCourses

  usecase "View Courses" as UC_ViewCourses
  usecase "Register for Course" as UC_Register
  usecase "Drop Course" as UC_Drop
  usecase "View Marks" as UC_ViewMarks
  usecase "View Transcript" as UC_Transcript
  usecase "View Course Teachers" as UC_ViewTeachers
  usecase "Rate Teacher" as UC_RateTeacher
  usecase "Join Club" as UC_JoinClub
  usecase "Assign Research Supervisor" as UC_AssignSupervisor

  usecase "Approve Registration" as UC_ApproveRegistration
  usecase "Approve All Registrations" as UC_ApproveAll
  usecase "Add Course for Registration" as UC_AddCourse
  usecase "Assign Teacher to Course" as UC_AssignTeacher
  usecase "Generate Academic Report" as UC_AcademicReport
  usecase "Manage News" as UC_News
  usecase "View Students Sorted by GPA" as UC_StudentsGpa
  usecase "View Teachers Alphabetically" as UC_TeachersAlpha
  usecase "View Employee Requests" as UC_Requests

  usecase "View Assigned Courses" as UC_ViewAssignedCourses
  usecase "View Students Info" as UC_StudentInfo
  usecase "Put Marks" as UC_PutMarks
  usecase "Send Message" as UC_Message
  usecase "Send Complaint" as UC_Complaint

  usecase "Create Researcher Role" as UC_CreateResearcher
  usecase "Publish Research Paper" as UC_PublishPaper
  usecase "Create Research Project" as UC_CreateProject
  usecase "Join Research Project" as UC_JoinProject
  usecase "Print Own Papers Sorted" as UC_PrintOwnPapers
  usecase "Print All Papers Sorted" as UC_PrintAllPapers
  usecase "View Top-Cited Researcher by School" as UC_TopSchool
  usecase "View Top-Cited Researcher by Year" as UC_TopYear

  usecase "Save/Load Serialized Data" as UC_Storage
}

Guest --> UC_Login

User --> UC_Logout
User --> UC_ChangePassword
User --> UC_DeleteAccount

Admin --> UC_ManageUsers
Admin --> UC_ManageCourses
Admin --> UC_ViewLogs
Admin --> UC_Storage
UC_ManageUsers .> UC_AddUser : <<include>>
UC_ManageUsers .> UC_UpdateUser : <<include>>
UC_ManageUsers .> UC_RemoveUser : <<include>>

Student --> UC_ViewCourses
Student --> UC_Register
Student --> UC_Drop
Student --> UC_ViewMarks
Student --> UC_Transcript
Student --> UC_ViewTeachers
Student --> UC_RateTeacher
Student --> UC_JoinClub
Student --> UC_AssignSupervisor

Manager --> UC_ApproveRegistration
Manager --> UC_ApproveAll
Manager --> UC_AddCourse
Manager --> UC_AssignTeacher
Manager --> UC_AcademicReport
Manager --> UC_News
Manager --> UC_StudentsGpa
Manager --> UC_TeachersAlpha
Manager --> UC_Requests

Teacher --> UC_ViewAssignedCourses
Teacher --> UC_StudentInfo
Teacher --> UC_PutMarks

Employee --> UC_Message
Employee --> UC_Complaint

Researcher --> UC_CreateResearcher
Researcher --> UC_PublishPaper
Researcher --> UC_CreateProject
Researcher --> UC_JoinProject
Researcher --> UC_PrintOwnPapers
Researcher --> UC_PrintAllPapers
Researcher --> UC_TopSchool
Researcher --> UC_TopYear

UC_Register .> UC_ViewCourses : <<include>>
UC_Drop .> UC_ViewCourses : <<include>>
UC_Transcript .> UC_ViewMarks : <<include>>
UC_PutMarks .> UC_ViewAssignedCourses : <<include>>
UC_ApproveRegistration .> UC_Register : <<extend>>
UC_AssignSupervisor .> UC_CreateResearcher : <<include>>
UC_PrintAllPapers .> UC_TopSchool : <<extend>>
UC_PrintAllPapers .> UC_TopYear : <<extend>>

note bottom of UC_Storage
DataStorage serializes UniversitySystem
with users, courses, enrollments,
research data, news and logs.
end note

@enduml
